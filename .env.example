# ==========================================================================================
# AI Model Marketplace - configuration. Copy to .env (scripts/start.* does this automatically).
# ==========================================================================================

# --- REQUIRED --------------------------------------------------------------------------
# Operator passphrase (>= 12 chars). It protects the local CA private key and the content-key
# escrow. It is read ONLY from the environment; it is never written to the database or storage.
# Keep it secret and DO NOT LOSE IT: without it the CA key and escrowed model keys cannot be opened.
MARKETPLACE_MASTER_PASSPHRASE=change-me-generated-by-start-script

# --- Database --------------------------------------------------------------------------
# auto  = use MongoDB when reachable, else the persistent file-backed DEVELOPMENT fallback
# mongo = require MongoDB (refuse to start without it)    file = force the development fallback
DB_MODE=auto
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=model_marketplace

# --- Blockchain (local Hardhat node) ----------------------------------------------------
CHAIN_RPC_URL=http://127.0.0.1:8545
# Hardhat's public Account #0 - LOCAL DEVELOPMENT ONLY. It acts as the marketplace operator/admin
# that authorizes developer wallets and tops them up with test ETH.
CHAIN_ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AUTO_FUND_WALLETS=true
FUND_AMOUNT_ETH=5

# --- Optional --------------------------------------------------------------------------
# MARKETPLACE_STORAGE=./storage       where models, datasets, the CA and the dev DB are kept
# MAX_UPLOAD_MB=50                    maximum dataset upload size
# MERKLE_CHUNK_SIZE=16384             bytes per Merkle leaf
# DOWNLOAD_TTL_SECONDS=600            lifetime of a decrypted-download token
# SESSION_TTL_HOURS=12
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# API_ACCESS_LOG=./tests/results/access_log.txt   append every /api call (used by tests/endpoint_coverage.py)
